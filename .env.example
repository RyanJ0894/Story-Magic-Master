# Story Magic - Environment Variables Template
# Copy this file to .env.local and fill in the values
# DO NOT COMMIT .env.local

# ===================
# Supabase Configuration
# ===================
SUPABASE_PROJECT_NAME=story-magic
SUPABASE_DB_PASSWORD=

# Supabase API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===================
# API Keys
# ===================
OPENAI_API_KEY=sk-...
ELEVENLABS_API_KEY=sk_...
GROQ_API_KEY=gsk_...

# ===================
# Stripe
# ===================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ===================
# Director Agent
# ===================
DIRECTOR_MODEL=openai/gpt-4.1
AUDIO_DIRECTOR_MODEL=openai/gpt-4.1

# ===================
# Service URLs
# ===================
# Local development
DIRECTOR_URL=http://localhost:8000
ORCHESTRATOR_URL=http://localhost:3001

# Production (update these for deployment)
# DIRECTOR_URL=https://your-director.onrender.com
# ORCHESTRATOR_URL=https://your-orchestrator.onrender.com

# ===================
# Production Tooling
# ===================
# Sentry Error Tracking (https://sentry.io)
SENTRY_DSN=https://your-dsn@sentry.io/project-id
SENTRY_AUTH_TOKEN=

# Upstash Redis - Rate Limiting (https://upstash.com)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Checkly - Uptime Monitoring (https://checklyhq.com)
CHECKLY_PING_URL=https://ping.checklyhq.com/your-check-id

# Logtail - Log Aggregation (https://logtail.com) [optional]
LOGTAIL_TOKEN=
