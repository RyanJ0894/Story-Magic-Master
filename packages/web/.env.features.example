# =============================================================================
# Feature Flags Configuration
# =============================================================================
#
# Copy these to your .env.local file to enable features.
# All features are DISABLED by default to protect current functionality.
#
# Priority:
#   1. Environment variables (production/staging)
#   2. URL parameters in development (?ff_story_score=true)
#   3. Default values (all false)
#
# =============================================================================

# -----------------------------------------------------------------------------
# Phase 1: StoryScore (12-dimension screenplay evaluation)
# -----------------------------------------------------------------------------
# Enable to show StoryScore component on project pages
# NEXT_PUBLIC_FF_STORY_SCORE=true

# -----------------------------------------------------------------------------
# Phase 2: Story-Adviser (Inline suggestions & rewrites)
# -----------------------------------------------------------------------------
# Requires: STORY_SCORE must also be enabled
# NEXT_PUBLIC_FF_STORY_ADVISER=true

# Revision tracking (score history, version comparison)
# Requires: STORY_SCORE must also be enabled
# NEXT_PUBLIC_FF_REVISION_TRACKING=true

# In-app script editor with CodeMirror
# Requires: STORY_ADVISER must also be enabled
# NEXT_PUBLIC_FF_SCRIPT_EDITOR=true

# -----------------------------------------------------------------------------
# Phase 3: Advanced Features
# -----------------------------------------------------------------------------
# Comparable scripts from corpus (requires pgvector corpus)
# Requires: STORY_SCORE must also be enabled
# NEXT_PUBLIC_FF_COMPARABLE_SCRIPTS=true

# PDF export of StoryScore reports
# Requires: STORY_SCORE must also be enabled
# NEXT_PUBLIC_FF_EXPORT_REPORTS=true

# =============================================================================
# Development Quick-Start
# =============================================================================
#
# To test features in development without modifying .env.local,
# add URL parameters:
#
#   http://localhost:22000/projects/abc123?ff_story_score=true
#   http://localhost:22000/projects/abc123?ff_story_adviser=true
#
# This only works in NODE_ENV=development
#
# =============================================================================
