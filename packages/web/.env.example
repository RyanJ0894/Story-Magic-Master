# Story Magic — Web Service Environment Variables
# Copy to .env.local for local development. Never commit actual values.
# All required vars are validated by scripts/check-env-web.js before deploy.
#
# Render dashboard: https://dashboard.render.com/web/srv-d5mmo2emcj7s73c6ffs0
# ============================================================================

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Valid: development | test | staging | production

# ── Database ──────────────────────────────────────────────────────────────────
# Injected automatically by Render from the story-magic-db reference.
# For local dev, use the external connection URL from the Render dashboard.
DATABASE_URL=postgresql://story_magic_user:PASSWORD@HOST:5432/story_magic
DIRECT_DATABASE_URL=postgresql://story_magic_user:PASSWORD@HOST:5432/story_magic
# Note: DIRECT_DATABASE_URL is needed by Prisma for migrations (bypasses PgBouncer).

# ── Clerk Auth ────────────────────────────────────────────────────────────────
# Get from: https://dashboard.clerk.com → Your App → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Production: use sk_live_ and pk_live_ keys
CLERK_WEBHOOK_SECRET=whsec_...
# Get from: Clerk dashboard → Webhooks → signing secret

# Clerk URL configuration (keep these as-is for all environments)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ── Stripe ────────────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com → Developers → API Keys
# Required in production/staging. For local: set to test keys to enable billing flows.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Get webhook secret from: Stripe dashboard → Webhooks → signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Orchestrator (Audio Service) ──────────────────────────────────────────────
# Internal Render URL in production: https://story-magic-orchestrator.onrender.com
ORCHESTRATOR_URL=http://localhost:22002
NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:22002

# ── Inter-service Auth ────────────────────────────────────────────────────────
# Must match SERVICE_SECRET_KEY on the orchestrator service.
# Generate: openssl rand -hex 32
SERVICE_SECRET_KEY=

# ── Upstash Redis (Job Queue + Rate Limiting) ─────────────────────────────────
# Required. Get from: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://YOUR_REDIS.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ── Queue Worker ──────────────────────────────────────────────────────────────
# How many audio jobs to process concurrently (default: 3)
QUEUE_CONCURRENCY=3

# ── App URL ───────────────────────────────────────────────────────────────────
# Full public URL of the web service (used in emails, webhooks)
NEXT_PUBLIC_APP_URL=https://app.storymagicapp.net

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Optional — invite emails, receipt notifications
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_...
# Set to "false" in production to send real emails
EMAIL_TESTING_MODE=true
ADMIN_EMAIL=info@servicevision.net

# ── Cron Secret ───────────────────────────────────────────────────────────────
# Must match CRON_SECRET on the impact-prize-draw cron service
# Generate: openssl rand -hex 32
CRON_SECRET=

# ── AI Services (optional — for intelligence features) ───────────────────────
# Required for StoryScore, Story-Adviser, comparable scripts features
ANTHROPIC_API_KEY=sk-ant-...
# Fallback LLM provider
OPENAI_API_KEY=sk-proj-...

# ── Cloudflare R2 (Impact Audio Storage) ─────────────────────────────────────
# Optional — required for Impact StoryBuilder audio uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=story-magic-impact-audio
R2_PUBLIC_URL=https://pub-XXXXX.r2.dev
R2_VOICES_ACCOUNT_ID=
R2_VOICES_ACCESS_KEY_ID=
R2_VOICES_SECRET_ACCESS_KEY=
R2_VOICES_BUCKET_NAME=story-magic-voices

# ── Sentry (Error Tracking) ───────────────────────────────────────────────────
# Optional but strongly recommended in production
SENTRY_DSN=https://XXXXX@XXXXX.ingest.sentry.io/XXXXX
NEXT_PUBLIC_SENTRY_DSN=https://XXXXX@XXXXX.ingest.sentry.io/XXXXX
SENTRY_AUTH_TOKEN=sntrys_...

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_BUCKET_URL=

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Intelligence features (Phases 2–3)
NEXT_PUBLIC_FF_STORY_SCORE=true
NEXT_PUBLIC_FF_STORY_ADVISER=false
NEXT_PUBLIC_FF_REVISION_TRACKING=false
NEXT_PUBLIC_FF_COMPARABLE_SCRIPTS=false
NEXT_PUBLIC_FF_EXPORT_REPORTS=false
NEXT_PUBLIC_FF_STORY_EXPLORER=false

# Impact StoryBuilder features
NEXT_PUBLIC_FF_IMPACT_STORYBUILDER=false
NEXT_PUBLIC_FF_IMPACT_GALLERY=false
NEXT_PUBLIC_FF_IMPACT_PARTNERS=false

# ── Referral Codes ────────────────────────────────────────────────────────────
# Optional. JSON object mapping referral code (uppercase) → tier name.
# Merges with built-in codes defined in app/api/referral/upgrade/route.ts.
# Valid tiers: creator | pro | studio | enterprise
# Example: {"PARTNER2026":"studio","VIPCODE":"enterprise"}
# Leave unset to use built-in codes only.
REFERRAL_CODES=
