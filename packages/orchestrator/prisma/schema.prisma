// Orchestrator-specific Prisma Schema
//
// Minimal schema for the orchestrator package. Contains only the models
// that the orchestrator accesses via typed Prisma methods. Raw SQL queries
// (voice_map, tts_stems, job progress updates) do not require schema models.
//
// This decouples the orchestrator build from the web package's Prisma schema.
// Both packages share the same database but generate independent Prisma clients.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// PROJECT (read-only access for ownership verification and job lookup)
// =============================================================================

model Project {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String   @map("user_id")
  name                  String
  description           String?
  status                String   @default("draft")
  scriptText            String?  @map("script_text")
  pageCount             Int      @default(0) @map("page_count")
  directorJson          Json?    @map("director_json")
  preferredWorkflowMode String   @default("automatic") @map("preferred_workflow_mode")
  currentRunNumber      Int      @default(0) @map("current_run_number")
  voiceAssignments      Json     @default("[]") @map("voice_assignments")
  audioOverrides        Json     @default("[]") @map("audio_overrides")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([userId, createdAt(sort: Desc)])
  @@map("projects")
}

// =============================================================================
// PURCHASE (read-only: look up Advanced Analysis upgrades for model selection)
// =============================================================================

model Purchase {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String   @map("user_id")
  projectId             String?  @map("project_id") @db.Uuid
  purchaseType          String   @map("purchase_type")
  amountCents           Int      @map("amount_cents")
  currency              String   @default("usd")
  stripePaymentIntentId String?  @unique @map("stripe_payment_intent_id")
  stripeInvoiceId       String?  @map("stripe_invoice_id")
  status                String   @default("completed")
  createdAt             DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([projectId])
  @@index([projectId, purchaseType, status])
  @@map("purchases")
}

// =============================================================================
// MIX MANIFEST (written by mixer after each scene mix)
// =============================================================================

model MixManifest {
  projectId       String   @map("project_id")
  sceneId         String   @map("scene_id")
  mixManifestJson Json     @map("mix_manifest_json")
  createdAt       DateTime @default(now()) @map("created_at")

  @@id([projectId, sceneId])
  @@map("mix_manifests")
}

// =============================================================================
// TIMELINE (written by timeline worker after each scene)
// =============================================================================

model Timeline {
  projectId    String   @map("project_id")
  sceneId      String   @map("scene_id")
  timelineJson Json     @map("timeline_json")
  createdAt    DateTime @default(now()) @map("created_at")

  @@id([projectId, sceneId])
  @@map("timelines")
}

// =============================================================================
// ALIGNMENT (written by align worker after each scene)
// =============================================================================

model Alignment {
  projectId     String   @map("project_id")
  sceneId       String   @map("scene_id")
  alignmentJson Json     @map("alignment_json")
  createdAt     DateTime @default(now()) @map("created_at")

  @@id([projectId, sceneId])
  @@map("alignments")
}

// =============================================================================
// TTS STEMS (cache of generated TTS audio per line)
// =============================================================================

model TtsStem {
  projectId String  @map("project_id")
  sceneId   String  @map("scene_id")
  lineId    String  @map("line_id")
  textHash  String? @map("text_hash")
  voiceHash String? @map("voice_hash")
  path      String?
  durationS Float?  @map("duration_s")

  @@id([projectId, sceneId, lineId])
  @@map("tts_stems")
}

// =============================================================================
// VOICE MAP (character → ElevenLabs voice assignments per project)
// =============================================================================

model VoiceMap {
  projectId  String @map("project_id")
  character  String
  voiceId    String @map("voice_id")
  provider   String @default("elevenlabs")
  paramsJson Json   @default("{}") @map("params_json")

  @@id([projectId, character])
  @@map("voice_map")
}
