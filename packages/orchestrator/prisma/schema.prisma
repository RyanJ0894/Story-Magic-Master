// Orchestrator-specific Prisma Schema
//
// Minimal schema for the orchestrator package. Contains only the models
// that the orchestrator accesses via typed Prisma methods. Raw SQL queries
// (voice_map, tts_stems, job progress updates) do not require schema models.
//
// This decouples the orchestrator build from the web package's Prisma schema.
// Both packages share the same database but generate independent Prisma clients.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// PROJECT (read-only access for ownership verification and job lookup)
// =============================================================================

model Project {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String   @map("user_id")
  name                  String
  description           String?
  status                String   @default("draft")
  scriptText            String?  @map("script_text")
  pageCount             Int      @default(0) @map("page_count")
  directorJson          Json?    @map("director_json")
  preferredWorkflowMode String   @default("automatic") @map("preferred_workflow_mode")
  currentRunNumber      Int      @default(0) @map("current_run_number")
  voiceAssignments      Json     @default("[]") @map("voice_assignments")
  audioOverrides        Json     @default("[]") @map("audio_overrides")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([userId, createdAt(sort: Desc)])
  @@map("projects")
}
