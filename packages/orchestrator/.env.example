# Story Magic — Orchestrator Service Environment Variables
# Copy to .env.local for local development. Never commit actual values.
# All required vars are validated by scripts/check-env-orchestrator.js before deploy.
#
# Render dashboard: https://dashboard.render.com/web/srv-d5mmo2emcj7s73c6ffr0
# ============================================================================

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=22002
LOG_LEVEL=info
# Valid LOG_LEVEL: trace | debug | info | warn | error

# ── Database ──────────────────────────────────────────────────────────────────
# Injected automatically by Render from the story-magic-db reference.
# For local dev, use the external connection URL from the Render dashboard.
DATABASE_URL=postgresql://story_magic_user:PASSWORD@HOST:5432/story_magic

# ── Clerk Auth ────────────────────────────────────────────────────────────────
# Used to verify incoming JWT tokens from the web service.
# Get from: https://dashboard.clerk.com → Your App → API Keys
CLERK_SECRET_KEY=sk_test_...

# ── Inter-service Auth ────────────────────────────────────────────────────────
# Must match SERVICE_SECRET_KEY on the web service.
# Generate: openssl rand -hex 32
SERVICE_SECRET_KEY=

# Auth bypass — MUST be false in production (fail-fast enforced)
AUTH_DISABLED=false

# ── LLM / AI Models ──────────────────────────────────────────────────────────
# At least one provider key is required.
# AI SDK v6 + @ai-sdk/anthropic v3 — all Claude models supported including claude-sonnet-4-6
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...
GROQ_API_KEY=gsk_...

# Model used for Director pipeline (scene/character analysis)
DIRECTOR_MODEL=anthropic/claude-sonnet-4-6

# Model used for Advanced Analysis (paid per-project add-on)
# Defaults to claude-opus-4-6 — users who purchased Advanced Analysis get this model.
DIRECTOR_MODEL_ADVANCED=anthropic/claude-opus-4-6

# Model used for Audio Director (voice selection, music cues)
AUDIO_DIRECTOR_MODEL=anthropic/claude-sonnet-4-6

# ── ElevenLabs (TTS) ──────────────────────────────────────────────────────────
# Required — this is the core audio generation service.
# Get from: https://elevenlabs.io/app/api-key
ELEVENLABS_API_KEY=sk_...

# ElevenLabs TTS model (default: eleven_turbo_v2_5 — 3× faster, same cost as v2)
# eleven_multilingual_v2 — for non-English scripts
# eleven_flash_v2_5     — maximum speed, slight quality trade-off
ELEVENLABS_MODEL=eleven_turbo_v2_5

# TTS concurrency (how many ElevenLabs requests in parallel)
# Reduce to 2 if hitting rate limits; increase to 5+ on paid plans
TTS_CONCURRENCY=3

# ── Audio Storage ─────────────────────────────────────────────────────────────
# Directory for generated audio files.
# Must be on a Render persistent disk in production (mount: /var/data/audio).
# Files stored here are lost on redeploy without the disk.
AUDIO_OUTPUT_DIR=/var/data/audio

# ── CORS / Web URL ────────────────────────────────────────────────────────────
# Required in production — frontend URL added to CORS allowlist
WEB_URL=https://app.storymagicapp.net

# ── Public URL ────────────────────────────────────────────────────────────────
# Used to build audio download links returned to the web service
ORCHESTRATOR_PUBLIC_URL=https://story-magic-orchestrator.onrender.com

# ── Upstash Redis (Rate Limiting) ─────────────────────────────────────────────
# Optional — falls back to in-memory rate limiting if not set
UPSTASH_REDIS_REST_URL=https://YOUR_REDIS.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ── Sentry (Error Tracking) ───────────────────────────────────────────────────
# Optional but strongly recommended in production
SENTRY_DSN=https://XXXXX@XXXXX.ingest.sentry.io/XXXXX

# ── Checkly (Uptime Monitoring) ───────────────────────────────────────────────
# Optional — heartbeat ping URL from Checkly dashboard
CHECKLY_PING_URL=https://api.checklyhq.com/heartbeats/ping/XXXXX
