{
  "name": "@story-magic/orchestrator",
  "version": "2.0.0",
  "description": "Consolidated audio production service for Story Magic (Director + Orchestrator)",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc",
    "prisma:generate": "prisma generate",
    "start": "node dist/index.js",
    "dev": "PORT=22002 tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:legacy": "node tests/test-orchestrator.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.15",
    "@ai-sdk/google": "^3.0.10",
    "@ai-sdk/groq": "^1.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "@clerk/backend": "^2.30.1",
    "@prisma/client": "^6.19.2",
    "@sentry/node": "^10.34.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.1",
    "ai": "^4.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "execa": "^8.0.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "form-data": "^4.0.5",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "p-limit": "^5.0.0",
    "pino": "^10.2.0",
    "pino-http": "^11.0.0",
    "prisma": "^6.19.2",
    "typescript": "^5.3.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.17",
    "eslint": "^8.56.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.7.0",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
