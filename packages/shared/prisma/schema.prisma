/// Every successful or failed LLM call from `runAgentLoop` or
/// `generateStructuredOutput` writes one row here. Lets us answer the
/// "what did this script cost?" question with SQL instead of grep + guess.
///
/// `projectId` is nullable because some calls (script-score quick triage,
/// startup health checks) don't have one. Most have it.
///
/// Cost estimates use a hardcoded price table in `lib/llm-call-log.ts`
/// keyed on model name (cents per million tokens). Update yearly.
model LlmCallLog {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId       String?  @map("project_id")
  operation       String
  model           String
  provider        String
  inputTokens     Int?     @map("input_tokens")
  outputTokens   Int?     @map("output_tokens")
  costEstimateUsd Decimal? @db.Decimal(10, 6) @map("cost_estimate_usd")
  durationMs      Int      @map("duration_ms")
  succeeded       Boolean
  errorMessage    String?  @map("error_message")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([projectId, createdAt(sort: Desc)], map: "llm_call_log_project_created_idx")
  @@index([operation, createdAt(sort: Desc)], map: "llm_call_log_operation_created_idx")
  @@index([createdAt], map: "llm_call_log_created_idx")
  @@map("llm_call_log")
}

/// Scene-level render cache (T2-2 of cost-opt Phase 2, issue #190).
///
/// When the orchestrator pipeline renders a scene, it hashes the scene's
/// content-defining inputs (dialogue text, voice assignments, audio cues,
/// mix params) into `contentHash` and stores the resulting scene .m4a path
/// here. On a subsequent run, a matching `contentHash` short-circuits the
/// expensive alignment + cue + timeline + mix steps for that scene.
///
/// Keyed on (projectId, sceneId) — a single row per scene per project, and
/// `contentHash` is the validation token. Index on `contentHash` exists for
/// a potential future "cross-project reuse" feature; the current pipeline
/// only checks within the same project.
model SceneRender {
  projectId   String   @map("project_id")
  sceneId     String   @map("scene_id")
  contentHash String   @map("content_hash")
  scenePath   String   @map("scene_path")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([projectId, sceneId])
  @@index([contentHash], map: "scene_renders_content_hash_idx")
  @@map("scene_renders")
}

model VoiceMap {
  projectId  String @map("project_id")
  character  String
  voiceId    String @map("voice_id")
  provider   String @default("elevenlabs")
  paramsJson Json   @default("{}") @map("params_json")

  @@id([projectId, character])
  @@map("voice_map")
}

// =============================================================================
// AI HEALTH MONITORING
// =============================================================================

model AiHealthLog {
  id           String   @id @default(cuid())
  provider     String                       // 'anthropic' | 'openai' | 'elevenlabs' | 'google'
  status       String                       // 'healthy' | 'degraded' | 'down'
  errorCode    String?  @map("error_code")  // 'INVALID_KEY' | 'QUOTA_EXCEEDED' | 'RATE_LIMITED' | 'TIMEOUT' | 'UNREACHABLE'
  errorMessage String?  @map("error_message")
  latencyMs    Int?     @map("latency_ms")
  triggeredBy  String   @default("preflight") @map("triggered_by")
  checkedAt    DateTime @default(now()) @map("checked_at") @db.Timestamptz

  @@index([provider, checkedAt])
  @@index([checkedAt])
  @@map("ai_health_log")
}
