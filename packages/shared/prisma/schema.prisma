model ScriptCorpus {
  id                String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title             String
  logline           String?
  genre             String[]                     @default([])
  tone              String?
  writer            String?
  saleDate          DateTime?                    @map("sale_date") @db.Date
  productionStatus  String?                      @map("production_status")
  studio            String?
  budgetTier        String?                      @map("budget_tier")
  boxOfficeMillions Decimal?                     @map("box_office_millions") @db.Decimal(10, 2)
  loglineEmbedding  Unsupported("vector(1536)")? @map("logline_embedding")
  isPublic          Boolean                      @default(false) @map("is_public")
  source            String?
  uploadedBy        String?                      @map("uploaded_by")
  createdAt         DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Training dataset fields
  scriptText        String?                      @map("script_text")
  datasetCategory   String?                      @map("dataset_category") // Oscar Winner, Black List, Produced Benchmark, Weak Film, TV Benchmark
  act1BreakPage     Int?                         @map("act1_break_page")
  act2BreakPage     Int?                         @map("act2_break_page")
  dialoguePct       Decimal?                     @map("dialogue_pct") @db.Decimal(5, 2)
  sceneCount        Int?                         @map("scene_count")
  conflictDensity   Decimal?                     @map("conflict_density") @db.Decimal(5, 3)
  emotionalArcScore Decimal?                     @map("emotional_arc_score") @db.Decimal(4, 2)
  pageCount         Int?                         @map("page_count")
  pdfFilename       String?                      @map("pdf_filename")

  // Relations
  uploader     Profile?      @relation(fields: [uploadedBy], references: [id])
  corpusScores CorpusScore[]

  @@index([productionStatus])
  @@index([isPublic])
  @@index([datasetCategory])
  @@map("script_corpus")
}

model CorpusScore {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corpusScriptId  String   @map("corpus_script_id") @db.Uuid
  modelVersion    String   @map("model_version")
