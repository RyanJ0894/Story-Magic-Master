{
  "name": "@story-magic/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared Prisma schema, migrations, and generated client for all Story Magic packages",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2"
  },
  "devDependencies": {
    "prisma": "^6",
    "typescript": "^5",
    "vitest": "^4.0.17"
  }
}
